page { background: linear-gradient(180deg, #eef5ff 0, #f7f9fc 420rpx); }
.forum-page { padding: 26rpx 26rpx calc(182rpx + env(safe-area-inset-bottom)); }
.forum-header { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 6rpx 25rpx; }
.forum-eyebrow { margin-bottom: 4rpx; color: #2b7bd1; font-size: 15rpx; font-weight: 850; letter-spacing: 3rpx; }
.forum-title { color: #172239; font-size: 42rpx; font-weight: 900; }
.forum-subtitle { margin-top: 6rpx; color: #8792a4; font-size: 23rpx; }
.publish-post { padding: 15rpx 21rpx; background: linear-gradient(135deg, #3499f7, #225fe1); color: #fff; font-size: 23rpx; font-weight: 800; border-radius: 999rpx; box-shadow: 0 12rpx 25rpx rgba(35, 108, 224, .25); }
.header-actions { display: flex; align-items: center; }
.message-button { position: relative; margin-right: 13rpx; padding: 13rpx 17rpx; background: #eef4fb; color: #59718c; font-size: 21rpx; border-radius: 999rpx; }
.message-button text { position: absolute; top: -12rpx; right: -8rpx; min-width: 28rpx; height: 28rpx; padding: 0 4rpx; background: #f05a5f; color: #ffffff; font-size: 16rpx; line-height: 28rpx; text-align: center; border: 3rpx solid #ffffff; border-radius: 999rpx; }
.search-box { display: flex; align-items: center; height: 86rpx; padding: 0 25rpx; background: rgba(255,255,255,.92); border: 1rpx solid #e2e9f3; border-radius: 27rpx; box-shadow: 0 12rpx 30rpx rgba(29,67,119,.07); animation-delay: .06s; }
.search-icon { margin-right: 13rpx; color: #8791a1; font-size: 40rpx; }
.search-input { flex: 1; height: 82rpx; color: #263248; font-size: 26rpx; }
.category-scroll { width: 100%; margin: 15rpx 0 21rpx; white-space: nowrap; }
.category-list { display: inline-flex; min-width: 100%; }
.category-tab { position: relative; padding: 16rpx 24rpx 21rpx; color: #6d7789; font-size: 26rpx; }
.category-active { color: #1d293e; font-weight: 850; }
.category-active::after { position: absolute; bottom: 4rpx; left: 50%; width: 40rpx; height: 7rpx; background: #3a9cf7; border-radius: 7rpx; content: ''; transform: translateX(-50%); }
.hot-card { position: relative; overflow: hidden; box-sizing: border-box; min-height: 270rpx; margin-bottom: 25rpx; padding: 27rpx 28rpx 23rpx; background: linear-gradient(135deg, #f54942 0%, #ff6d49 55%, #ff9a58 100%); color: #fff; border: 1rpx solid rgba(255,255,255,.24); border-radius: 34rpx; box-shadow: 0 20rpx 44rpx rgba(226, 67, 44, .25); animation-delay: .13s; }
.hot-glow { position: absolute; top: -125rpx; right: -65rpx; width: 300rpx; height: 300rpx; background: rgba(255, 255, 255, .13); border-radius: 50%; }
.hot-heading { position: relative; display: flex; align-items: center; justify-content: space-between; }
.hot-badge { padding: 8rpx 15rpx; background: rgba(132, 22, 5, .17); font-size: 23rpx; font-weight: 900; border-radius: 999rpx; }
.hot-top { color: rgba(255, 255, 255, .78); font-size: 19rpx; font-weight: 800; letter-spacing: 2rpx; }
.hot-title { position: relative; display: -webkit-box; overflow: hidden; margin-top: 19rpx; font-size: 31rpx; font-weight: 900; line-height: 1.48; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.hot-bottom { position: relative; display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.hot-category { padding: 7rpx 13rpx; background: rgba(255, 255, 255, .18); font-size: 19rpx; border-radius: 999rpx; }
.hot-metrics { display: flex; align-items: center; color: rgba(255, 255, 255, .9); font-size: 19rpx; }
.hot-metrics text { margin-left: 18rpx; }
.hot-rule { position: relative; display: flex; align-items: center; justify-content: space-between; margin-top: 17rpx; padding-top: 15rpx; color: rgba(255, 255, 255, .76); font-size: 18rpx; border-top: 1rpx solid rgba(255, 255, 255, .18); }
.hot-rule text { color: #fff; font-size: 20rpx; font-weight: 800; }
.hot-empty { display: flex; align-items: center; margin-bottom: 24rpx; padding: 27rpx 25rpx; background: linear-gradient(135deg, #fff5ed, #fff); border: 1rpx solid #ffe3d2; border-radius: 27rpx; box-shadow: 0 8rpx 22rpx rgba(70, 48, 28, .04); }
.hot-empty-icon { margin-right: 18rpx; font-size: 42rpx; }
.hot-empty-copy { flex: 1; min-width: 0; }
.hot-empty-title { color: #3a3540; font-size: 25rpx; font-weight: 850; }
.hot-empty-copy text { display: block; margin-top: 6rpx; color: #9b8c86; font-size: 19rpx; }
.source-line { display: flex; align-items: center; margin: 0 5rpx 17rpx; color: #929cab; font-size: 20rpx; }
.source-dot { width: 10rpx; height: 10rpx; margin-right: 9rpx; background: #21c77b; border-radius: 50%; }
.post-card { margin-bottom: 22rpx; padding: 28rpx; background: rgba(255,255,255,.98); border: 1rpx solid rgba(225,232,242,.88); border-radius: 32rpx; box-shadow: 0 16rpx 40rpx rgba(30, 57, 98, .065); }
.post-head { display: flex; align-items: center; }
.post-avatar { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; background: linear-gradient(145deg, #e5f2ff, #cfe7ff); color: #2684df; font-size: 27rpx; font-weight: 900; border-radius: 50%; }
.author-copy { flex: 1; margin-left: 15rpx; }
.author-line { display: flex; align-items: center; min-width: 0; }
.author-name { color: #263248; font-size: 25rpx; font-weight: 800; }
.post-time { margin-top: 4rpx; color: #9ba4b2; font-size: 19rpx; }
.post-category { padding: 7rpx 13rpx; background: #eff6ff; color: #3187dc; font-size: 20rpx; border-radius: 999rpx; }
.post-more { margin-left: 13rpx; padding: 10rpx 0 10rpx 10rpx; color: #909aaa; font-size: 22rpx; letter-spacing: 2rpx; }
.post-content { margin-top: 21rpx; color: #293447; font-size: 28rpx; line-height: 1.72; white-space: pre-wrap; }
.post-images { display: flex; overflow: hidden; margin-top: 18rpx; gap: 8rpx; border-radius: 18rpx; }
.post-image { flex: 1; width: 0; height: 205rpx; background: #eef2f6; }
.images-1 .post-image { flex: none; width: 72%; height: 300rpx; border-radius: 18rpx; }
.post-actions { display: flex; align-items: center; margin-top: 21rpx; padding-top: 18rpx; color: #8b95a5; font-size: 22rpx; border-top: 1rpx solid #f0f2f6; }
.action-item { margin-right: 30rpx; }
.action-item text { margin-right: 6rpx; }
.liked { color: #f05c5c; }
.open-detail { margin-left: auto; color: #3387dc; }
.empty-state { padding: 80rpx 0 90rpx; text-align: center; }
.empty-icon { display: flex; align-items: center; justify-content: center; width: 90rpx; height: 90rpx; margin: auto; background: #eaf4ff; color: #2c89e5; font-weight: 900; border-radius: 28rpx; }
.empty-title { margin-top: 20rpx; color: #303a4c; font-size: 27rpx; font-weight: 850; }
.empty-text { margin-top: 8rpx; color: #9aa4b3; font-size: 22rpx; }
.empty-button { display: inline-block; margin-top: 22rpx; padding: 14rpx 24rpx; background: #eaf4ff; color: #2785e4; font-size: 22rpx; border-radius: 999rpx; }
.load-more, .list-end { padding: 28rpx 0 40rpx; color: #8a96aa; font-size: 24rpx; text-align: center; }
.load-more { color: #258af2; font-weight: 700; }
