page { background:#f4f7fb; }
.help-page { padding:28rpx 28rpx 70rpx; }
.hero { padding:34rpx; background:linear-gradient(135deg,#2563eb,#55a7ff); color:#fff; border-radius:30rpx; }
.hero-title { font-size:40rpx; font-weight:900; }
.hero-copy { margin-top:9rpx; font-size:23rpx; opacity:.82; }
.section-title { margin:34rpx 4rpx 16rpx; color:#1d293d; font-size:30rpx; font-weight:900; }
.feature-grid { overflow:hidden; background:#fff; border:1rpx solid #edf1f7; border-radius:25rpx; }
.feature { display:flex; align-items:center; padding:23rpx; border-bottom:1rpx solid #f0f3f7; }
.feature:last-child { border-bottom:none; }
.feature > view:nth-child(2) { flex:1; margin-left:18rpx; }
.feature > text { color:#a0a9b7; font-size:36rpx; }
.icon { display:flex; align-items:center; justify-content:center; width:68rpx; height:68rpx; font-size:23rpx; font-weight:900; border-radius:20rpx; }
.blue{background:#eaf2ff;color:#2563eb}.green{background:#eaf9f2;color:#059669}.purple{background:#f2efff;color:#7c62d7}.orange{background:#fff1e7;color:#ea711f}.cyan{background:#e8f8fb;color:#1594a8}.gray{background:#f1f5f9;color:#64748b}
.name { color:#344054; font-size:27rpx; font-weight:800; }.copy { margin-top:5rpx; color:#98a2b3; font-size:21rpx; }
.flow-card { margin-top:25rpx; padding:27rpx; background:#fff; border-radius:25rpx; }.flow-title{font-size:28rpx;font-weight:900}.flow{margin-top:15rpx;color:#475467;font-size:24rpx;line-height:1.8}.tip{margin-top:16rpx;padding:16rpx;background:#fff8e8;color:#8a6d32;font-size:21rpx;line-height:1.6;border-radius:14rpx}
.contact{margin-top:25rpx;height:86rpx;background:#fff;color:#2563eb;font-size:26rpx;font-weight:800;line-height:86rpx;border:1rpx solid #dbeafe;border-radius:22rpx}.contact::after{border:none}
