page{background:#f4f7fb}.page{padding:28rpx}.hero{padding:32rpx;background:linear-gradient(135deg,#172b4d,#3f628f);color:#fff;border-radius:28rpx}.title{font-size:38rpx;font-weight:900}.copy{margin-top:8rpx;font-size:21rpx;opacity:.78}.section{margin-top:22rpx;padding:25rpx;background:#fff;border-radius:24rpx}.section-title{color:#263248;font-size:28rpx;font-weight:900}.empty{padding:35rpx 0;color:#98a2b3;font-size:22rpx;text-align:center}.item{margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #edf1f6}.main{color:#344054;font-size:25rpx;font-weight:800}.meta,.detail{margin-top:8rpx;color:#7c8798;font-size:21rpx;line-height:1.6}.actions{display:flex;margin-top:15rpx}.actions button{flex:1;margin:0 7rpx;height:66rpx;background:#f1f5f9;color:#475467;font-size:22rpx;line-height:66rpx;border-radius:16rpx}.actions .primary,.full{background:#2563eb;color:#fff}.actions button::after,.full::after,.user button::after{border:none}.full{width:100%;height:66rpx;margin-top:15rpx;font-size:22rpx;line-height:66rpx;border-radius:16rpx}.user{display:flex;align-items:center;justify-content:space-between}.user button{height:60rpx;margin:0;background:#ecfdf5;color:#059669;font-size:21rpx;line-height:60rpx;border-radius:15rpx}
