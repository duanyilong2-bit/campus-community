<view class="page"><view class="hero"><view class="title">安全审核后台</view><view class="copy">校园认证、订单争议、用户反馈和黑名单</view></view>
<view class="section"><view class="section-title">待审核认证（{{verifications.length}}）</view><view class="empty" wx:if="{{!verifications.length}}">暂无待审核认证</view><view class="item" wx:for="{{verifications}}" wx:key="id"><view class="main">学号后几位：{{item.studentNoLast4}}</view><view class="meta">{{item.createdAt}}</view><view class="actions"><button data-url="{{item.proofUrl}}" bindtap="previewProof">查看凭证</button><button class="primary" data-id="{{item.id}}" bindtap="reviewVerification">审核</button></view></view></view>
<view class="section"><view class="section-title">待处理争议（{{disputes.length}}）</view><view class="empty" wx:if="{{!disputes.length}}">暂无待处理争议</view><view class="item" wx:for="{{disputes}}" wx:key="id"><view class="main">{{item.title}} · {{item.reason}}</view><view class="detail">{{item.description}}</view><view class="actions"><button data-user="{{item.otherUserId}}" bindtap="suspendUser">暂停相关账号</button><button class="primary" data-id="{{item.id}}" bindtap="resolveDispute">填写结果</button></view></view></view>
<view class="section"><view class="section-title">用户反馈（{{feedback.length}}）</view><view class="empty" wx:if="{{!feedback.length}}">暂无待处理反馈</view><view class="item" wx:for="{{feedback}}" wx:key="id"><view class="main">{{item.category}}</view><view class="detail">{{item.content}}</view><button class="full" data-id="{{item.id}}" bindtap="resolveFeedback">回复并完成</button></view></view>
<view class="section"><view class="section-title">已暂停账号（{{suspendedUsers.length}}）</view><view class="empty" wx:if="{{!suspendedUsers.length}}">暂无暂停账号</view><view class="item user" wx:for="{{suspendedUsers}}" wx:key="id"><text>{{item.nickname}}</text><button data-user="{{item.id}}" bindtap="restoreUser">恢复账号</button></view></view></view>
