page { background: #f4f7fb; }
.page { padding: 28rpx; }
.header { padding: 30rpx; background: linear-gradient(135deg,#172b4d,#345b91); color:#fff; border-radius:28rpx; }
.title { font-size: 40rpx; font-weight: 900; }
.copy { margin-top: 8rpx; font-size: 22rpx; opacity: .75; }
.empty { margin-top: 24rpx; padding: 100rpx 20rpx; background:#fff; color:#98a2b3; text-align:center; border-radius:25rpx; }
.card { margin-top:22rpx; padding:27rpx; background:#fff; border:1rpx solid #edf1f7; border-radius:25rpx; }
.row { display:flex; align-items:center; justify-content:space-between; }
.reason { color:#dc2626; font-size:25rpx; font-weight:800; }
.status { padding:7rpx 14rpx; background:#fff7ed; color:#ea580c; font-size:20rpx; border-radius:999rpx; }
.status-RESOLVED { background:#f1f5f9; color:#64748b; }
.content { margin-top:18rpx; color:#344054; font-size:27rpx; line-height:1.65; }
.meta { margin-top:12rpx; color:#98a2b3; font-size:21rpx; }
.handle { margin-top:22rpx; height:76rpx; background:#2563eb; color:#fff; font-size:25rpx; line-height:76rpx; border-radius:19rpx; }
.handle::after { border:none; }
