page{background:#f4f7fb}.page{padding:28rpx 28rpx 70rpx}.hero{display:flex;align-items:center;justify-content:space-between;padding:32rpx;background:linear-gradient(135deg,#1d4ed8,#55a6ff);color:#fff;border-radius:28rpx}.title{font-size:38rpx;font-weight:900}.copy{margin-top:8rpx;font-size:21rpx;opacity:.8}.account{padding:8rpx 14rpx;background:rgba(255,255,255,.18);font-size:20rpx;border-radius:999rpx}.card{margin-top:22rpx;padding:27rpx;background:#fff;border:1rpx solid #edf1f7;border-radius:25rpx}.card-head{display:flex;align-items:flex-start;justify-content:space-between}.card-title{color:#263248;font-size:29rpx;font-weight:900}.card-copy{margin-top:7rpx;color:#98a2b3;font-size:20rpx;line-height:1.5}.status{padding:7rpx 13rpx;background:#f1f5f9;color:#64748b;font-size:20rpx;border-radius:999rpx}.status-PENDING{background:#fff7ed;color:#ea580c}.status-VERIFIED{background:#ecfdf5;color:#059669}.status-REJECTED{background:#fef2f2;color:#dc2626}.input,.textarea{box-sizing:border-box;width:100%;margin-top:20rpx;padding:20rpx;background:#f7f9fc;color:#344054;font-size:24rpx;border-radius:17rpx}.textarea{height:190rpx}.picker{color:#667085}.proof{display:flex;align-items:center;justify-content:center;height:210rpx;margin-top:18rpx;background:#f7f9fc;color:#7c8798;font-size:23rpx;border:1rpx dashed #cfd8e6;border-radius:18rpx}.proof image{width:100%;height:100%;border-radius:18rpx}.privacy{margin-top:13rpx;color:#98a2b3;font-size:19rpx;line-height:1.6}.primary,.contact{height:78rpx;margin-top:20rpx;font-size:25rpx;font-weight:800;line-height:78rpx;border-radius:19rpx}.primary{background:#2563eb;color:#fff}.contact{background:#eef6ff;color:#2563eb}.primary::after,.contact::after{border:none}.result-tip{margin-top:20rpx;padding:18rpx;background:#fff7ed;color:#9a691d;font-size:23rpx;border-radius:15rpx}.result-tip.verified{background:#ecfdf5;color:#087a55}.record{margin-top:18rpx;padding-top:18rpx;color:#667085;font-size:21rpx;line-height:1.7;border-top:1rpx solid #edf1f6}.record text:first-child{color:#344054;font-size:25rpx;font-weight:800}.record-status{float:right;color:#2563eb}.legal{margin-top:25rpx;color:#64748b;font-size:22rpx;text-align:center}
.notice-status{flex-shrink:0;margin-left:18rpx;padding:8rpx 14rpx;background:#f1f5f9;color:#64748b;font-size:19rpx;border-radius:999rpx}.notice-status.ready{background:#ecfdf5;color:#059669}.subscription-renew{height:72rpx;margin-top:18rpx;background:#2563eb;color:#fff;font-size:23rpx;font-weight:800;line-height:72rpx;border-radius:17rpx}.subscription-renew::after{border:none}
