page { background: linear-gradient(180deg, #eaf3ff 0, #f6f8fc 600rpx); }
.profile-page { padding: 28rpx 26rpx calc(182rpx + env(safe-area-inset-bottom)); }
.profile-hero { position: relative; overflow: hidden; padding: 37rpx 31rpx 31rpx; background: linear-gradient(135deg, #153c91 0%, #2173dc 62%, #2fb5cc 125%); color: #fff; border: 1rpx solid rgba(255,255,255,.3); border-radius: 38rpx; box-shadow: 0 22rpx 52rpx rgba(23,80,164,.24); }
.hero-glow { position: absolute; background: rgba(255,255,255,.1); border-radius: 50%; }
.glow-one { top: -100rpx; right: -60rpx; width: 300rpx; height: 300rpx; }
.glow-two { bottom: -110rpx; left: 180rpx; width: 240rpx; height: 240rpx; }
.user-row { position: relative; display: flex; align-items: center; }
.avatar { display: flex; align-items: center; justify-content: center; width: 106rpx; height: 106rpx; background: linear-gradient(145deg, #58afff, #277eda); color: #fff; font-size: 42rpx; font-weight: 900; border: 7rpx solid rgba(255,255,255,.9); border-radius: 50%; box-shadow: 0 9rpx 24rpx rgba(43, 126, 215, .22); }
.avatar-image { box-sizing: content-box; }
.user-copy { flex: 1; margin-left: 20rpx; }
.nickname { color: #fff; font-size: 35rpx; font-weight: 900; }
.identity { display: flex; align-items: center; margin-top: 9rpx; color: rgba(255,255,255,.75); font-size: 22rpx; }
.identity-dot { width: 10rpx; height: 10rpx; margin-right: 8rpx; background: #22c77a; border-radius: 50%; }
.profile-actions { display: flex; align-items: center; margin-left: 12rpx; }
.edit-profile { padding: 11rpx 16rpx; background: rgba(255,255,255,.14); color: #fff; font-size: 20rpx; font-weight: 700; border: 1rpx solid rgba(255,255,255,.26); border-radius: 999rpx; }
.edit-profile text { margin-left: 4rpx; font-size: 25rpx; }
.campus-position { position: relative; display: flex; align-items: center; margin-top: 29rpx; padding: 19rpx; background: rgba(255,255,255,.12); border: 1rpx solid rgba(255,255,255,.22); border-radius: 23rpx; }
.campus-icon { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; background: #e6f2ff; color: #2d84de; font-size: 21rpx; font-weight: 900; border-radius: 17rpx; }
.campus-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; margin-left: 15rpx; }
.position-label { color: rgba(255,255,255,.62); font-size: 19rpx; }
.campus-name { margin-top: 4rpx; color: #fff; font-size: 25rpx; font-weight: 800; }
.verified { display: flex; align-items: center; margin-left: 12rpx; padding: 9rpx 13rpx; background: #fff7ed; color: #d97706; font-size: 20rpx; font-weight: 650; border-radius: 999rpx; }
.verified > text:first-child { display: flex; align-items: center; justify-content: center; width: 25rpx; height: 25rpx; margin-right: 6rpx; background: #f59e0b; color: #fff; font-size: 16rpx; border-radius: 50%; }
.verified.verified-active { background: #ecfdf5; color: #07825a; }
.verified.verified-active > text:first-child { background: #10b981; }
.verified-arrow { margin-left: 6rpx; color: currentColor; font-size: 25rpx; opacity: .72; }
.stats-card, .function-card, .info-card { margin-top: 23rpx; padding: 29rpx; background: rgba(255,255,255,.98); border: 1rpx solid rgba(225,232,242,.88); border-radius: 33rpx; box-shadow: 0 17rpx 42rpx rgba(30, 57, 98, .065); }
.stats-card { animation-delay: .08s; }
.stats-title-row { display: flex; align-items: center; justify-content: space-between; }
.stats-title, .section-title { color: #1e2a40; font-size: 31rpx; font-weight: 900; }
.stats-caption { margin-top: 6rpx; color: #939dac; font-size: 20rpx; }
.cloud-state { display: flex; align-items: center; color: #159e69; font-size: 20rpx; }
.cloud-state text { width: 10rpx; height: 10rpx; margin-right: 8rpx; background: #20c67a; border-radius: 50%; }
.stats-grid { display: flex; margin-top: 27rpx; padding: 22rpx 0; background: #f8faff; border-radius: 22rpx; }
.stat-item { position: relative; display: flex; flex: 1; flex-direction: column; align-items: center; }
.stat-item + .stat-item::before { position: absolute; top: 8rpx; bottom: 8rpx; left: 0; width: 1rpx; background: #e7edf5; content: ''; }
.stat-number { color: #17243a; font-size: 36rpx; font-weight: 900; }
.stat-label { margin-top: 6rpx; color: #7c889a; font-size: 22rpx; }
.blue-notice { display: flex; align-items: center; margin-top: 23rpx; padding: 24rpx 27rpx; background: linear-gradient(135deg, #287ff0, #1d56d6 72%, #1aa8c3); color: #fff; border-radius: 28rpx; box-shadow: 0 16rpx 34rpx rgba(35, 99, 220, .22); animation-delay: .13s; }
.notice-hand { margin-right: 17rpx; font-size: 38rpx; }
.notice-copy { flex: 1; font-size: 25rpx; font-weight: 750; }
.notice-copy text { display: block; margin-top: 5rpx; font-size: 20rpx; font-weight: 400; opacity: .8; }
.notice-arrow { font-size: 38rpx; opacity: .75; }
.function-card { padding: 31rpx 20rpx 13rpx; animation-delay: .18s; }
.section-caption { margin-top: 6rpx; color: #98a3b2; font-size: 20rpx; }
.function-grid { display: flex; flex-wrap: wrap; margin-top: 30rpx; }
.function-item { display: flex; align-items: center; justify-content: flex-start; flex-direction: column; box-sizing: border-box; width: 25%; min-height: 142rpx; margin-bottom: 24rpx; padding: 4rpx 2rpx; color: #3f4b60; font-size: 24rpx; font-weight: 600; }
.notification-function { position: relative; }
.function-badge { position: absolute; top: -2rpx; right: 12rpx; min-width: 30rpx; height: 30rpx; padding: 0 5rpx; background: #f05a5f; color: #ffffff; font-size: 17rpx; line-height: 30rpx; text-align: center; border: 3rpx solid #ffffff; border-radius: 999rpx; }
.function-icon { display: flex; align-items: center; justify-content: center; width: 91rpx; height: 91rpx; margin-bottom: 14rpx; font-size: 31rpx; font-weight: 900; border: 1rpx solid rgba(255,255,255,.85); border-radius: 27rpx; box-shadow: 0 10rpx 24rpx rgba(35, 73, 125, .09); }
.icon-blue { background: #edf5ff; color: #2e83db; }
.icon-green { background: #eaf9f3; color: #129c69; }
.icon-orange { background: #fff2e8; color: #ef761f; }
.icon-purple { background: #f3efff; color: #8065de; }
.icon-cyan { background: #eaf9fb; color: #1995aa; }
.icon-gray { background: #f0f2f5; color: #6f7a8b; }
.info-card { padding-top: 0; padding-bottom: 0; animation-delay: .23s; }
.info-row { display: flex; align-items: center; justify-content: space-between; padding: 25rpx 2rpx; color: #2d384b; font-size: 25rpx; border-bottom: 1rpx solid #f0f2f6; }
.info-row:last-child { border-bottom: none; }
.contact-row { box-sizing: border-box; width: 100%; margin: 0; background: transparent; line-height: normal; border-radius: 0; }
.contact-row::after { border: none; }
.admin-row { color: #dc2626; font-weight: 750; }
.info-row view { color: #8d97a7; font-size: 21rpx; }
.row-arrow { margin-left: 12rpx; color: #a0a9b7; font-size: 34rpx; }
.version-text { margin-top: 34rpx; color: #a5adba; font-size: 20rpx; text-align: center; }
